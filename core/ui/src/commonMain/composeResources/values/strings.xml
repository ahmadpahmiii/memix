<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- File sizes: %1$s is the number, already rounded, with decimal_separator as its decimal mark. A no-break space (\u00A0) keeps the unit on the number's line. -->
    <string name="file_size_bytes">%1$s\u00A0B</string>
    <string name="file_size_kilobytes">%1$s\u00A0kB</string>
    <string name="file_size_megabytes">%1$s\u00A0MB</string>
    <string name="file_size_gigabytes">%1$s\u00A0GB</string>
    <string name="file_size_terabytes">%1$s\u00A0TB</string>
    <string name="decimal_separator">.</string>
    <!-- Spoken times (spec P1-04 -> Copy), for screen readers only; the digits on screen are never translated.
         a11y_time_seconds: %1$s is a number with one decimal in the user's format ("3.2"); use the noun form your
         language uses after a decimal number. a11y_time_minutes_seconds: %1$s = a11y_minutes, %2$s = a11y_time_seconds. -->
    <string name="a11y_time_seconds">%1$s seconds</string>
    <plurals name="a11y_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <string name="a11y_time_minutes_seconds">%1$s %2$s</string>
    <string name="a11y_time_of">%1$s of %2$s</string>
</resources>
