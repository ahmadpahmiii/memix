    <!-- Spoken times (spec P1-04 -> Copy), for screen readers only; the digits on screen are never translated.
         a11y_time_seconds: %1$s is a number with one decimal in the user's format ("3.2"); use the noun form your
         language uses after a decimal number. a11y_time_minutes_seconds: %1$s = a11y_minutes, %2$s = a11y_time_seconds. -->
    <string name="a11y_time_seconds">%1$s seconds</string>
    <plurals name="a11y_minutes">
        <item quantity="one">%1$d minute</item>
