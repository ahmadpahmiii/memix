<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exports keep running when the user leaves Memix (P1-12): a foreground service of type mediaProcessing on
         Android 15+ and dataSync on 10–14. Notifications show its progress when the user allows them (Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Whether the phone is online, for the offline look of the Sounds screen (P3-04). A normal permission: no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- WhatsApp's own check of whether a pack is added (P2-09) lives in these two packages; Android 11+ hides them unless named here
         (WhatsApp's Android sample does the same). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application>
        <!-- The WhatsApp sticker packs (P2-09). Exported and enabled as WhatsApp requires, and readable only with the permission WhatsApp
             holds; it serves pack metadata and the files a pack lists, nothing else (StickerPackProvider). Its authority is
             StickerPackAuthority.of(context). -->
        <provider
            android:name="app.memix.platform.services.StickerPackProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />
        <service
            android:name="app.memix.platform.services.ExportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>
</manifest>
