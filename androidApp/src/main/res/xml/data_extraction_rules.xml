<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Media copies (files/media, see MediaPaths.ROOT) stay out of the cloud backup: its 25 MB quota is
     smaller than one video, and over the quota Android backs up nothing at all. Drafts (databases/memix.db) are still
     backed up; a draft restored without its media is the editor's "missing media" case. Device-to-device transfers
     have no section here, so they carry everything, media included. Sound files (files/sounds: the starter
     pack, written again from the app itself, and sounds downloaded from the library, P3-04, which download again) stay out
     too. The database is backed up with its list of downloaded sounds; a row whose file is missing is forgotten the first
     time it is read, so the sound downloads again. My sounds (files/mysounds, P3-07) stay out too: one sound can be 10 MB, so
     a few would pass the 25 MB quota and stop every backup. Their rows are backed up with the database; a restored row
     whose file is missing shows "That sound won't play" and can be deleted (known limit). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="media" />
        <exclude domain="file" path="sounds" />
        <exclude domain="file" path="mysounds" />
    </cloud-backup>
</data-extraction-rules>
