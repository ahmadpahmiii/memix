<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Media copies (files/media, see MediaPaths.ROOT) stay out of the cloud backup: its 25 MB quota is
     smaller than one video, and over the quota Android backs up nothing at all. Drafts (databases/memix.db) are still
     backed up; a draft restored without its media is the editor's "missing media" case. Device-to-device transfers
     have no section here, so they carry everything, media included. The starter sounds (files/sounds) are written
     again from the app itself the first time they're needed, so they don't need a backup either. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="media" />
        <exclude domain="file" path="sounds" />
    </cloud-backup>
</data-extraction-rules>
