# Copy to .env (gitignored) and fill in. Inventory and where each value comes from: docs/CREDENTIALS.md
# Never paste these values into chat, issues, commit messages or PR text.

# Supabase (project ref: lzxikotwhhezxgbfbtrh)
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Cloudflare R2: S3 API token with Object Read & Write on the media bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare API token (website deploys, P6-04)
CLOUDFLARE_API_TOKEN=

# Content intake (P3-12)
FREESOUND_API_KEY=
